# Propósito del archivo:
# Definir la plantilla de variables de entorno requeridas para la conexión a Supabase y PostgreSQL.
# Copiar este archivo como .env en el entorno local e ingresar los valores reales.

# Configuración de Supabase (Cliente y Servidor)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-llave-anonima-publica"

# Conexión a Base de Datos PostgreSQL mediante Prisma ORM
DATABASE_URL="postgresql://usuario:contrasena@host:5432/nombre_base_datos?schema=public"